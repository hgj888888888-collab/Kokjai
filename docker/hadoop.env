# Hadoop / Hive 容器共享的环境变量
# 命名规则：<配置文件前缀>_CONF_<参数名>，参数名中的 '.' 换成 '_'
#   例如 CORE_CONF_fs_defaultFS  ->  core-site.xml 里的 fs.defaultFS

# ---------- core-site.xml ----------
CORE_CONF_fs_defaultFS=hdfs://namenode:9000

# ---------- hdfs-site.xml ----------
# 单节点，副本数设为 1（默认 3 会因为副本不足一直报警告）
HDFS_CONF_dfs_replication=1
# 关闭权限检查，避免容器间用户不同导致 HDFS 写不进去
HDFS_CONF_dfs_permissions_enabled=false
# 允许 WebHDFS（方便用浏览器/接口查看 HDFS）
HDFS_CONF_dfs_webhdfs_enabled=true
# 关闭 DataNode 注册时的主机名反向解析检查（容器环境下常见报错就出在这）
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
# 强制 WebUI 监听 0.0.0.0，否则容器间访问 9870 端口会 Connection refused
HDFS_CONF_dfs_namenode_http___address=0.0.0.0:9870
HDFS_CONF_dfs_datanode_http___address=0.0.0.0:9864

# ---------- mapred-site.xml ----------
# 用 local 模式跑 MapReduce，这样不需要额外的 YARN 容器，省内存
MAPRED_CONF_mapreduce_framework_name=local
# 注意：local 模式下 map 任务在 HiveServer2 自己的 JVM 里跑，
# 180519 行明细会把 512m 的堆撑爆（OutOfMemoryError: Java heap space），
# 所以子任务堆与 HiveServer2 堆都要调大。
MAPRED_CONF_mapred_child_java_opts=-Xmx1024m

# ---------- hive-site.xml ----------
# Hive 元数据存到 PostgreSQL
HIVE_SITE_CONF_javax_jdo_option_ConnectionURL=jdbc:postgresql://metastore-db/metastore
HIVE_SITE_CONF_javax_jdo_option_ConnectionDriverName=org.postgresql.Driver
HIVE_SITE_CONF_javax_jdo_option_ConnectionUserName=hive
HIVE_SITE_CONF_javax_jdo_option_ConnectionPassword=hive
HIVE_SITE_CONF_javax_jdo_option_ConnectionDriverName=org.postgresql.Driver
# 默认建表落到 HDFS
HIVE_SITE_CONF_hive_metastore_warehouse_dir=hdfs://namenode:9000/user/hive/warehouse
# 限制单个 Hive 任务内存，8G 虚拟机要省着用
# local 模式下 HiveServer2 承担全部计算，512 太小会 OOM，调整为 2048
HIVE_SITE_CONF_hive_tez_container_size=512
HIVE_SITE_CONF_hive_server2_heapsize=2048
